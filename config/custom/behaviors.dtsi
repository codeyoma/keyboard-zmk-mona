/**
 *	https://zmk.dev/docs/config/behaviors
 */


&lt {
    flavor                  = "tap-preferred";
    tapping-term-ms         = <LT_TAPPING_TERM_MS>;
    quick-tap-ms            = <0>;
    require-prior-idle-ms   = <IDLE_MS>;
};

&mt {
    flavor                  = "tap-preferred";
	tapping-term-ms         = <TAPPING_TERM_MS>;
	quick-tap-ms            = <QUICK_TAP_MS>;
};

/ {
	behaviors {

        // The KeyLay key: opens or closes the KeyLay cheat sheet, see src/keylay.c
        keylay: keylay {
            compatible              = "zmk,behavior-keylay";
            #binding-cells          = <0>;
        };

        hm: home_row_mods {
            compatible              = "zmk,behavior-hold-tap";
            #binding-cells          = <2>;
            flavor                  = "balanced";
            require-prior-idle-ms   = <IDLE_MS>;
            tapping-term-ms         = <TAPPING_TERM_MS>;
            quick-tap-ms            = <QUICK_TAP_MS>;
            bindings                = <&kp>, <&kp>;
        };

        // Alt home row mod: holds only after the tapping term, since Option + letter types
        // special characters on macOS (get_permissive_hold on the Charybdis)
        hm_alt: home_row_mods_alt {
            compatible              = "zmk,behavior-hold-tap";
            #binding-cells          = <2>;
            flavor                  = "tap-preferred";
            require-prior-idle-ms   = <IDLE_MS>;
            tapping-term-ms         = <TAPPING_TERM_MS>;
            quick-tap-ms            = <QUICK_TAP_MS>;
            bindings                = <&kp>, <&kp>;
        };

        // Steps a trackball speed level: &mouse_speed MS_NORMAL (DPI_MOD on the Charybdis) or
        // &mouse_speed MS_SNIPE (S_D_MOD). See src/mouse_speed.c and
        // boards/shields/mona2/trackball_input.dtsi
        mouse_speed: mouse_speed {
            compatible              = "zmk,behavior-mouse-speed";
            #binding-cells          = <1>;
        };

        td_sqt: tap_dance_quote {
            compatible              = "zmk,behavior-tap-dance";
            #binding-cells          = <0>;
            tapping-term-ms         = <LT_TAPPING_TERM_MS>;
            bindings                = <&kp SQT>, <&kp DQT>;
        };

        /*
        td_lower_sp: tap_dance_lower_space {
            compatible              = "zmk,behavior-tap-dance";
            #binding-cells          = <0>;
            tapping-term-ms         = <LT_TAPPING_TERM_MS>;
            bindings                = <&mo LOWER>, <&kp SPACE>;
        };
        */

        /*
        td: tap_dance_mods {
            compatible              = "zmk,behavior-tap-dance";
            #binding-cells          = <0>;
            tapping-term-ms         = <TD_TAPPING_TERM_MS>;
            bindings                = <&kp>, <&kp>;
        };
        */

    };
};
