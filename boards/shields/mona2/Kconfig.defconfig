# The right half has the trackball and is the central.
if SHIELD_MONA2_R

config ZMK_KEYBOARD_NAME
    default "moNa2"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_POINTING
    default y

config SPI
    default y

config PAW3222
    default y

endif

if SHIELD_MONA2_L || SHIELD_MONA2_R

config ZMK_SPLIT
    default y

endif
